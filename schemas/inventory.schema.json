{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omfgnick/ops-toolkit/schemas/inventory.schema.json",
  "title": "inventory.sh --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collected_at",
    "identity",
    "os",
    "cpu",
    "memory",
    "disks",
    "interfaces",
    "packages"
  ],
  "properties": {
    "collected_at": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "fqdn",
        "vendor",
        "model",
        "serial"
      ],
      "properties": {
        "hostname": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "serial": {
          "type": [
            "string",
            "null"
          ],
          "description": "null sem root/dmidecode"
        }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "version",
        "kernel",
        "arch",
        "uptime"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "uptime": {
          "type": "string"
        }
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "count"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_kb"
      ],
      "properties": {
        "total_kb": {
          "type": "integer"
        }
      }
    },
    "disks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "model"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "address"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager",
        "count"
      ],
      "properties": {
        "manager": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
